#!/bin/sh
# pre-push 守卫:禁止本地内部文档、配置和旧同步工具推入远端。
#
# 生效方式:git config core.hooksPath .githooks
#
# 判定方式:检查待推送提交的完整树,而不是增量 diff ——
# 只要最终推上去的树里出现内部路径就拦,与本次改了哪些文件无关。

remote="$1"

pattern='^(docs/(internal|superpowers|reports)/|docs/(FIX_EXECUTION_REPORT\.md|REFACTOR_PLAN\.md|SYSTEM_REVIEW_[^/]+\.md)$|tools/(sync_public|sync_obsidian)\.ps1$|MOBILE_EVAL\.tmp\.md$|\.vscode/settings\.json$|\.tmp_srv\.(out|err)$|\.claude/|\.workbuddy/|(^|/)\.env[^/]*$)'

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # 推送删除分支时 local_sha 全为 0,没有内容可查
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    hits=$(git ls-tree -r --name-only "$local_sha" 2>/dev/null | grep -E "$pattern" | grep -Ev '(^|/)\.env\.example$')
    if [ -n "$hits" ]; then
        printf '\n[pre-push 拦截] 本地内部路径不允许推送到 %s (%s):\n' "$remote" "$remote_ref" >&2
        printf '%s\n' "$hits" | sed -n '1,20p' | sed 's/^/  ! /' >&2
        printf '\n这些文件只应保留在本地工作区；请勿使用 --no-verify 绕过守卫。\n\n' >&2
        status=1
    fi
done

exit $status
