#!/bin/sh
# pre-push 守卫:禁止内部开发文档进入公开仓(origin)。
# 私有开发仓(dev)放行。
#
# 生效方式:git config core.hooksPath .githooks
#
# 判定方式:检查待推送提交的完整树,而不是增量 diff ——
# 只要最终推上去的树里出现内部路径就拦,与本次改了哪些文件无关。
#
# 背景:2026-11-08 与 2026-11-21 两次内部文档误入公开仓(15 个 / 49 个),
# 都是事后重建历史才清掉。此钩子把"事后清理"提前为"推送前拦截"。
# 维护约定:与 tools/sync_public.ps1 的 ExcludeDirs/ExcludeFiles/ExcludeGlobs
# 保持同一份清单,改动任一处必须同步另一处。

remote="$1"

# 私有开发仓不做限制
if [ "$remote" = "dev" ]; then
    exit 0
fi

pattern='^(docs/(internal|superpowers|reports)/|docs/FIX_EXECUTION_REPORT\.md$|docs/REFACTOR_PLAN\.md$|docs/SYSTEM_REVIEW_[^/]+\.md$)'

status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # 推送删除分支时 local_sha 全为 0,没有内容可查
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac

    hits=$(git ls-tree -r --name-only "$local_sha" 2>/dev/null | grep -E "$pattern")
    if [ -n "$hits" ]; then
        printf '\n[pre-push 拦截] 内部开发文档不允许推送到 %s (%s):\n' "$remote" "$remote_ref" >&2
        printf '%s\n' "$hits" | sed -n '1,20p' | sed 's/^/  ! /' >&2
        printf '\n这些文件只应留在私有仓 dev 或本地工作区。\n' >&2
        printf '确认无误要强推,请用 git push --no-verify。\n\n' >&2
        status=1
    fi
done

exit $status
