# ============================================================
# Foxclaw 配置文件模板
# ============================================================
# 用法:
#   1. 复制本文件,改名为 .env(去掉 .example)
#   2. 在下面填入你自己的 Key(等号后面,不要加引号)
#   3. 启动:foxclaw serve(等价于 python -m uvicorn foxclaw.api:app --port 8000)
#
# 说明:
#   - 所有 Key 都是可选的,不填则对应功能降级/禁用
#   - .env 文件不会被分发(已在 .gitignore),你的 Key 是安全的
#   - 至少配一个大模型 Key,系统才能真实工作(否则 stub 降级)
#   - 改完跑一遍 `foxclaw config check`:会指出类型写错、拼错的键(比如多打一个 S
#     导致设置根本不生效)、以及互相矛盾的组合(如只配 KEY_ID 不配 SECRET)。
#     该命令只读,不会修改你的 .env。
# ============================================================

# ---------- 大模型(配任意一个即可,系统自动探测)----------
# DeepSeek(国内,性价比高,需 pip install openai)
DEEPSEEK_API_KEY=

# Claude
ANTHROPIC_API_KEY=

# OpenAI GPT(需 pip install openai)
OPENAI_API_KEY=

# Google Gemini(需 pip install google-generativeai)
GOOGLE_API_KEY=

# 通义千问(需 pip install openai)
DASHSCOPE_API_KEY=

# 本地模型 Ollama/vLLM(填 base_url,如 http://localhost:11434/v1)
LOCAL_LLM_BASE=

# 可选:强制指定模型名(不填则用各 provider 默认,如 deepseek-chat)
FOXCLAW_MODEL=

# ---------- 高德地图(行政 Agent 用,两个 Key 功能不同)----------
# Web服务 Key:后端查真实路线/地理编码/POI(在高德控制台选「Web服务」)
AMAP_MAPS_API_KEY=

# Web端(JS API)Key:前端画地图(在高德控制台选「Web端(JS API)」)
AMAP_JS_KEY=

# Web端安全密钥 jscode:2021 年后申请的 JSAPI Key 必须配,与上面 Key 配对
AMAP_JS_SCODE=

# ---------- 联网搜索(可选,让 Agent 能查实时信息)----------
# 百度 AI 搜索(千帆 ai_search,底层百度搜索 + ERNIE),国内稳定,每日 100 次免费额度。
# 在百度千帆 AppBuilder 控制台申请 API Key:https://qianfan.cloud.baidu.com
# 不配则 Agent 无法联网,问"最新版本/今日新闻"会如实说查不到(不编造)
BAIDU_SEARCH_KEY=
# 搜索用的模型(可选,默认 ernie-3.5-8k;想更强可填 ernie-4.5-turbo-32k)
BAIDU_SEARCH_MODEL=ernie-3.5-8k
# 搜索接入点(默认即此,一般不用改)
BAIDU_SEARCH_BASE=https://qianfan.baidubce.com/v2/ai_search

# ---------- 运行参数(可选)----------
# 数据目录
FOXCLAW_DATA_DIR=./foxclaw_data

# Harness 影子校准轮数(越小越快进入拦截模式)
FOXCLAW_SHADOW_ROUNDS=20

# 联网搜索 · 读取超时(秒)。深度搜索慢,默认 45;可调大避免超时
BAIDU_SEARCH_TIMEOUT=60
# 联网搜索 · 深度搜索开关:1=更全但慢(几十秒) / 0=普通搜索更快(~5-10秒)
# 只做快速信息检索填 0 即可
BAIDU_SEARCH_DEEP=0

# ---------- 上下文预算(2026-11 接入 Compactor)----------
# 单次 LLM 调用的上下文上限(估算 token)。超过则按「LLM 摘要 → 部分摘要 → 截断」
# 三级降级压缩,保留系统提示与最近 4 组消息。置 0 关闭压缩(退回按条数硬截)。
FOXCLAW_CONTEXT_MAX_TOKENS=6000

# ---------- 安全(2026-11 加固,建议按需启用)----------
# DNS rebinding 防护:Host 头为公网域名时拒绝本机数据面请求。自建域名/反代访问时
# 把域名填进来(逗号分隔,支持 *.example.com),否则会被 403。
FOXCLAW_ALLOWED_HOSTS=

# 浏览器导航默认拒绝 file://、javascript:、内网/回环地址(SSRF 防护)。
# 需要让 Agent 访问局域网设备(如 192.168.x.x 的路由器后台)时才置 1。
FOXCLAW_BROWSER_ALLOW_PRIVATE=0

# 渠道发送者白名单:只有列出的 sender_id 发来的消息才按「指令」执行,
# 其余一律包成 <untrusted> 数据块(可作答、不执行)。逗号分隔,支持
# `sender_id` 或 `channel:sender_id`;`*` 表示全信任(不推荐,等于放弃这层防护)。
FOXCLAW_CHANNEL_TRUSTED_SENDERS=

# 单个工具调用的硬超时(秒)。超时即跳过该步并回注「未完成」提示,防一个慢工具拖死整轮。
FOXCLAW_TOOL_TIMEOUT=45

# ---------- 出站渠道签名(2026-11 接入,可选)----------
# 与自建网关(OpenClaw 桥)共享的 HMAC 密钥。配置后出站请求带
# X-Foxclaw-Signature/Timestamp/Nonce(签名覆盖 timestamp+nonce+正文摘要),
# 网关侧用同一密钥验签即可确认「真伪 + 未被篡改 + 未重放」。
# 留空 = 不签(opt-in)。**一旦配置,签名失败就不发送**(fail-closed,不降级成明文)。
# 注意:Telegram/Discord/飞书/微信官方 API 不验我们的签名,这条只对「两端都自己控制」
# 的网关链路有意义,别指望它防官方渠道。
FOXCLAW_CHANNEL_SIGNING_SECRET=
# 密钥轮换时用于对账(随签名一起发送,不参与签名计算)。可留空。
FOXCLAW_CHANNEL_SIGNING_KEY_ID=
