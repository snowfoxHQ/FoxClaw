# ============================================================
# Foxclaw 配置文件模板
# ============================================================
# 用法:
#   1. 复制本文件,改名为 .env(去掉 .example)
#   2. 在下面填入你自己的 Key(等号后面,不要加引号)
#   3. 启动:foxclaw serve(等价于 python -m uvicorn foxclaw.api:app --port 8000)
#
# 说明:
#   - 所有 Key 都是可选的,不填则对应功能降级/禁用
#   - .env 文件不会被分发(已在 .gitignore),你的 Key 是安全的
#   - 至少配一个大模型 Key,系统才能真实工作(否则 stub 降级)
#   - 改完跑一遍 `foxclaw config check`:会指出类型写错、拼错的键(比如多打一个 S
#     导致设置根本不生效)、以及互相矛盾的组合(如只配 KEY_ID 不配 SECRET)。
#     该命令只读,不会修改你的 .env。
# ============================================================

# ---------- 大模型(配任意一个即可,系统自动探测)----------
# DeepSeek(国内,性价比高,需 pip install openai)
DEEPSEEK_API_KEY=

# Claude
ANTHROPIC_API_KEY=

# OpenAI GPT(需 pip install openai)
OPENAI_API_KEY=

# Google Gemini(需 pip install google-generativeai)
GOOGLE_API_KEY=

# 通义千问(需 pip install openai)
DASHSCOPE_API_KEY=

# 本地模型 Ollama/vLLM(填 base_url,如 http://localhost:11434/v1)
LOCAL_LLM_BASE=

# 可选:强制指定模型名(不填则用各 provider 默认,如 deepseek-chat)
FOXCLAW_MODEL=

# ---------- 高德地图(行政 Agent 用,两个 Key 功能不同)----------
# Web服务 Key:后端查真实路线/地理编码/POI(在高德控制台选「Web服务」)
AMAP_MAPS_API_KEY=

# Web端(JS API)Key:前端画地图(在高德控制台选「Web端(JS API)」)
AMAP_JS_KEY=

# Web端安全密钥 jscode:2021 年后申请的 JSAPI Key 必须配,与上面 Key 配对
AMAP_JS_SCODE=

# ---------- 联网搜索(可选,让 Agent 能查实时信息)----------
# 百度 AI 搜索(千帆 ai_search,底层百度搜索 + ERNIE),国内稳定,每日 100 次免费额度。
# 在百度千帆 AppBuilder 控制台申请 API Key:https://qianfan.cloud.baidu.com
# 不配则 Agent 无法联网,问"最新版本/今日新闻"会如实说查不到(不编造)
BAIDU_SEARCH_KEY=
# 搜索用的模型(可选,默认 ernie-3.5-8k;想更强可填 ernie-4.5-turbo-32k)
BAIDU_SEARCH_MODEL=ernie-3.5-8k
# 搜索接入点(默认即此,一般不用改)
BAIDU_SEARCH_BASE=https://qianfan.baidubce.com/v2/ai_search

# ★ 系统唯一本地 embedding(HKC 检索 + HMR 记忆 + Harness 漂移 + Evidence 语义 全用这个)
# 解析优先级(vendor/hmr/storage/vector_store.py):
#   EMBEDDING_MODEL > HKC_EMBEDDING_MODEL > FOXCLAW_EMBEDDING_MODEL > all-MiniLM-L6-v2
# 填本地目录(如 D:\models\bge-m3)可完全离线;填 HF 仓库名(如 BAAI/bge-m3)则用缓存。
# 换模型会让已落盘的向量维度不匹配,启动时告警并要求重建索引。
EMBEDDING_MODEL=

# ---------- HKC 知识库行为开关(2026-11)----------
# auto = 本地 SentenceTransformer 优先,不可用则退 stub
# local = 强制本地;stub = 不加载模型(检索退化为关键词);tei = 走远程服务(配 URL)
HKC_EMBEDDING=auto
# 仅 HKC_EMBEDDING=tei 时使用
HKC_EMBEDDING_URL=http://localhost:8080
# 只给 HKC 单独指定模型;留空则跟随 EMBEDDING_MODEL
HKC_EMBEDDING_MODEL=
# 知识库数据目录
HKC_DATA_DIR=./hkc_data
# 单文档最多切多少 chunk(默认安全值 800 段 ≈ 125 万字符)
# 0 或负数 = 不限制:上传上限 20MB ≈ 4400 段,一次误传会在后台连跑数小时并持续计费,
# 且截断后同文件重传会被去重拦截、只能拆分后补传 —— 除非确需整本摄入,否则别设 0。
HKC_MAX_CHUNKS_PER_DOC=800
# 抽取并发(默认 4)/ 每批条数(默认 1)
HKC_EXTRACT_CONCURRENCY=4
HKC_EXTRACT_BATCH=1
# 单次抽取 LLM 超时(秒)
HKC_LLM_TIMEOUT=60
# 累计向量数超过此值时索引自动升级 Flat → IVF(默认 10000;0=禁用)
HKC_VECTOR_IVF_THRESHOLD=10000
# embedding 计算线程数(默认 2)
HKC_EMB_TORCH_THREADS=2

# ---------- 记忆后端(2026-11)----------
# hmr(默认) | vecrecall。vecrecall 落盘在独立子目录,不与 hmr 混写;
# 切换不迁移旧数据,切回 hmr 时原数据仍在。
# 兼容 hestiaOS 旧变量名:FOXCLAW_ 为空时读 HESTIA_MEMORY_BACKEND。
FOXCLAW_MEMORY_BACKEND=hmr
# 1 = 每条记忆同步写 sha256 区块(哈希链,可审计防篡改)。仅 vecrecall 生效,
# 开启后存储量约翻倍。兼容 HESTIA_MEMORY_CHAIN。
FOXCLAW_MEMORY_CHAIN=0

# ---------- 运行参数(可选)----------
# 数据目录
FOXCLAW_DATA_DIR=./foxclaw_data
# `foxclaw skills install @owner/slug` 走的 ClawHub 地址。默认 https://clawhub.ai;
# 内网镜像或自建 registry 填这里。只在装技能时访问,平时不发任何请求。
FOXCLAW_CLAWHUB_REGISTRY=
# 导入白名单:/api/{finance,learning,itinerary}/import 的 csv_path 只允许数据目录内的文件。
# 要从别处导入(如下载目录),把目录填进来,逗号分隔。
FOXCLAW_IMPORT_ROOTS=

# Harness 影子校准轮数(越小越快进入拦截模式)
FOXCLAW_SHADOW_ROUNDS=20

# 新版本检查。默认关:foxclaw 本地优先,不该在你不说的情况下外呼。
# 设 1 后启动/首次打开界面时查一次 PyPI(pypi.org/pypi/foxclaw/json),24h 缓存,
# 有新版时顶栏版本号旁出现提示;只发这一个 GET,不带任何本机信息。
FOXCLAW_UPDATE_CHECK=0

# 不联网校验模型版本。模型已缓存但机器连不上 huggingface.co 时打开,可跳过
# 每次构造前 5 次重试的空等(约 20-40s);模型还没下载过时别开,否则无法自动下载。
# HF_HUB_OFFLINE=1

# MCP server:1=启动时同时暴露 MCP 端点,供外部 Agent 接入
FOXCLAW_MCP_SERVER=0

# 联网搜索 · 读取超时(秒)。深度搜索慢,默认 45;可调大避免超时
BAIDU_SEARCH_TIMEOUT=60
# 联网搜索 · 深度搜索开关:1=更全但慢(几十秒) / 0=普通搜索更快(~5-10秒)
# 只做快速信息检索填 0 即可
BAIDU_SEARCH_DEEP=0

# ---------- 上下文预算(2026-11 接入 Compactor)----------
# 单次 LLM 调用的上下文上限(估算 token)。超过则按「LLM 摘要 → 部分摘要 → 截断」
# 三级降级压缩,保留系统提示与最近 4 组消息。置 0 关闭压缩(退回按条数硬截)。
FOXCLAW_CONTEXT_MAX_TOKENS=6000

# ---------- 安全(2026-11 加固,建议按需启用)----------
# DNS rebinding 防护:Host 头为公网域名时拒绝本机数据面请求。自建域名/反代访问时
# 把域名填进来(逗号分隔,支持 *.example.com),否则会被 403。
FOXCLAW_ALLOWED_HOSTS=

# 浏览器导航默认拒绝 file://、javascript:、内网/回环地址(SSRF 防护)。
# 需要让 Agent 访问局域网设备(如 192.168.x.x 的路由器后台)时才置 1。
FOXCLAW_BROWSER_ALLOW_PRIVATE=0

# 渠道发送者白名单:只有列出的 sender_id 发来的消息才按「指令」执行,
# 其余一律包成 <untrusted> 数据块(可作答、不执行)。逗号分隔,支持
# `sender_id` / `channel:sender_id` / `channel:*`(该渠道下全部发送者)。
# 裸 `*` 不再自动生效,需同时设 FOXCLAW_CHANNEL_TRUST_ALL=1(等于放弃这层防护,不推荐)。
FOXCLAW_CHANNEL_TRUSTED_SENDERS=
# 显式开启「所有渠道所有发送者都可信」。仅在你完全清楚后果时设置。
FOXCLAW_CHANNEL_TRUST_ALL=

# 单个工具调用的硬超时(秒)。超时即跳过该步并回注「未完成」提示,防一个慢工具拖死整轮。
FOXCLAW_TOOL_TIMEOUT=45

# ---------- 出站渠道签名(2026-11 接入,可选)----------
# 与自建网关(OpenClaw 桥)共享的 HMAC 密钥。配置后出站请求带
# X-Foxclaw-Signature/Timestamp/Nonce(签名覆盖 timestamp+nonce+正文摘要),
# 网关侧用同一密钥验签即可确认「真伪 + 未被篡改 + 未重放」。
# 留空 = 不签(opt-in)。**一旦配置,签名失败就不发送**(fail-closed,不降级成明文)。
# 注意:Telegram/Discord/飞书/微信官方 API 不验我们的签名,这条只对「两端都自己控制」
# 的网关链路有意义,别指望它防官方渠道。
FOXCLAW_CHANNEL_SIGNING_SECRET=
# 密钥轮换时用于对账(随签名一起发送,不参与签名计算)。可留空。
FOXCLAW_CHANNEL_SIGNING_KEY_ID=

# ---------- 服务鉴权(2026-11 补齐)----------
# 设了它,/api/* /knowledge/* /config/* /stats 对「非本机」客户端要求 X-API-Key 头。
# 本机(127.0.0.1 / ::1)默认仍免密,见 FOXCLAW_LOOPBACK_BYPASS。
# 对外暴露(FOXCLAW_HOST=0.0.0.0)时必填,否则任何能连上端口的人都能读你的知识/记忆。
FOXCLAW_API_KEY=
# 设为 0 则本机也强制校验(前端目前不会自动带 key,打开后浏览器访问会 401)。
# FOXCLAW_LOOPBACK_BYPASS=1
